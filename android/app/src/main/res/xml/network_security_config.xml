<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system"/>
            <certificates src="user"/>
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">readyplayer.me</domain>
        <domain includeSubdomains="true">models.readyplayer.me</domain>
        <domain includeSubdomains="true">demo.readyplayer.me</domain>
    </domain-config>
</network-security-config>